# ViralScopes.io — Environment Variables Reference
#
# Copy to .env.local (apps/web) and/or .env (apps/api) and fill in real values.
# Never commit a file containing real secrets — only this template is committed.
# Full descriptions: see README.md section 7 "Environment Variables".

# ── Application ──────────────────────────────────────────────────────────
APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ── Database (Supabase / PostgreSQL) — required starting Phase 3 ─────────
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DATABASE_POOL_SIZE=10
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Redis — required starting Phase 2 ─────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── Authentication — required starting Phase 4 ────────────────────────────
JWT_SECRET=replace-with-a-random-secret-minimum-32-characters
JWT_REFRESH_SECRET=replace-with-a-random-secret-minimum-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── YouTube Data API — required starting Phase 5 ──────────────────────────
YOUTUBE_API_KEY=
YOUTUBE_QUOTA_LIMIT=10000
RAPIDAPI_YOUTUBE_KEY=

# ── AI APIs — required starting Phase 6 ───────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Stripe — required starting Phase 9 ────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email — required starting Phase 4 ─────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=hello@viralscopes.io
EMAIL_FROM_NAME=ViralScopes

# ── Object Storage (S3-compatible: MinIO dev / Cloudflare R2 prod) ────────
S3_BUCKET=viralscopes-dev
S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Frontend (public, exposed to the browser) ─────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── n8n — required starting Phase 6 ───────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=http://localhost:5678
