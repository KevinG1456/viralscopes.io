# ViralScopes.io — Environment Variable Reference
#
# Copy to .env.local (see README.md §7 for exact steps) and fill in real
# values. Never commit .env.local, .env.production, or any file containing
# real secrets — only this file (placeholders only) is committed.
#
# Categories in this file:
#   REQUIRED NOW        — read by code or Docker Compose today; missing/
#                          invalid values fail fast at startup (apps/api) or
#                          break `docker compose up` (Compose-only vars).
#   OPTIONAL NOW         — read today, but has a safe default.
#   REQUIRED STARTING PHASE N — not read by any code yet; will become load-
#                          bearing when that phase's feature lands.
#
# Full reference: README.md §7

# ============================================================
# REQUIRED NOW / OPTIONAL NOW — validated at apps/api startup
# (see apps/api/src/config.ts). Invalid values fail fast with a
# clear error instead of booting with a silently-wrong config.
# ============================================================

# OPTIONAL — one of: development | staging | production | test. Defaults to
# development. Invalid values are rejected at startup.
APP_ENV=development

# OPTIONAL — TCP port the API listens on. Defaults to 3001 (also the
# Dockerfile.api EXPOSE port). Must be a valid port number.
PORT=3001

# OPTIONAL — free-text version string shown by GET /health. Set automatically
# by CI (APP_VERSION=<git sha>) in built images; harmless to leave unset
# locally (falls back to "unknown").
APP_VERSION=

# OPTIONAL — one of: error | warn | info | debug | trace. Defaults to info.
# Invalid values are rejected at startup, same as APP_ENV/PORT.
LOG_LEVEL=info

# ============================================================
# REQUIRED NOW — read by docker-compose.dev.yml / docker-compose.prod.yml.
# Missing values fall back to Compose's own defaults (dev only) or break
# `docker compose up` (prod, no safe default for a password).
# ============================================================

APP_URL=http://localhost:3000

# n8n admin credentials (docker-compose.dev.yml / .prod.yml)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=http://localhost:5678

# Shared secret between apps/api and n8n (Phase 6). apps/api's
# requireServiceToken middleware validates this on every
# /api/v1/internal/* request; n8n's exported workflows
# (infra/n8n-workflows/) attach it via {{$env.N8N_SERVICE_TOKEN}} in their
# HTTP Request nodes' headers. Generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
N8N_SERVICE_TOKEN=

# MinIO (dev) / Cloudflare R2 (prod) credentials — docker-compose.dev.yml
# maps these to MINIO_ROOT_USER/MINIO_ROOT_PASSWORD with dev-only defaults
# (minioadmin/minioadmin) if left blank locally.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Grafana admin password (docker-compose.dev.yml / .prod.yml). Defaults to
# "admin" in dev only — docker-compose.prod.yml has no default; it must be
# set in .env.production.
GRAFANA_ADMIN_PASSWORD=admin

# Redis password — required in docker-compose.prod.yml (no default there);
# dev Redis runs without a password (see INFRASTRUCTURE_GROWTH_PLAN.md §8.3).
REDIS_PASSWORD=

# Production domains — only used for Traefik routing in docker-compose.prod.yml,
# which isn't deployed anywhere yet (no server/domain provisioned).
APP_DOMAIN=app.viralscopes.io
API_DOMAIN=api.viralscopes.io
N8N_DOMAIN=n8n.viralscopes.io
GRAFANA_DOMAIN=grafana.viralscopes.io

# Postgres (docker-compose.dev.yml's postgres service). Defaults to
# postgres/postgres/viralscopes if left blank locally — fine for dev, must
# be set to a real password in .env.production.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=viralscopes

# ============================================================
# REQUIRED NOW — read by packages/db (src/migrate.ts, src/seeds/run.ts,
# src/reset.ts, src/setup-roles.ts). Points at the postgres service above
# for local dev.
#
# Production still targets a Supabase-hosted Postgres instance (see
# Database_Schema.md header), but only Postgres itself — this project
# authenticates with its own JWT/OAuth system (Security_Architecture.md §5),
# not Supabase Auth, so Supabase's anon/service-role API keys are never
# used and are intentionally not listed here.
#
# DATABASE_URL is the superuser/owner connection — migrations and seeds use
# it because DDL requires those privileges. It must NEVER be what the
# running application connects with: Postgres superusers and table owners
# bypass Row Level Security unconditionally, so RLS would silently do
# nothing. The application (from Phase 5 onward) must use DATABASE_APP_URL
# instead, which connects as the restricted app_user role created by
# `npm run db:setup-roles` — see packages/db/src/setup-roles.ts.
# ============================================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/viralscopes
DATABASE_POOL_SIZE=10

# APP_DB_PASSWORD and the password segment of DATABASE_APP_URL must match --
# `npm run db:setup-roles` sets the role's password from APP_DB_PASSWORD.
APP_DB_USER=app_user
APP_DB_PASSWORD=your-local-app-db-password
DATABASE_APP_URL=postgresql://app_user:your-local-app-db-password@localhost:5432/viralscopes

# ============================================================
# REQUIRED STARTING PHASE 2 (later milestone) / PHASE 5 — Redis client,
# object storage abstraction. The Redis and MinIO *containers* already run
# today (docker-compose.dev.yml); these specific variables are for the
# application-level clients that don't exist yet.
# ============================================================

REDIS_URL=redis://localhost:6379

S3_BUCKET=viralscopes-dev
S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
# MinIO requires path-style addressing; Cloudflare R2 / AWS S3 use
# virtual-hosted style — set to false in production.
S3_FORCE_PATH_STYLE=true

# ============================================================
# REQUIRED STARTING PHASE 4 — Authentication & Authorisation
# ============================================================

JWT_SECRET=your-local-jwt-secret-minimum-32-chars
JWT_REFRESH_SECRET=your-local-refresh-secret-minimum-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=hello@viralscopes.io
EMAIL_FROM_NAME=ViralScopes

# ============================================================
# REQUIRED STARTING PHASE 5 — Core Backend API (YouTube discovery)
# ============================================================

YOUTUBE_API_KEY=
YOUTUBE_QUOTA_LIMIT=10000
RAPIDAPI_YOUTUBE_KEY=

# ============================================================
# REQUIRED STARTING PHASE 6 — n8n Workflow Engine (AI analysis pipeline)
# ============================================================

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# apps/api's own copy of the shared secret above -- must be the identical
# value set for the n8n container, or requireServiceToken rejects every
# call from n8n's workflows with 401.
N8N_SERVICE_TOKEN=

# Where apps/api sends the manual-trigger webhook call
# (POST /api/v1/admin/jobs/:workflow/trigger) -- the n8n container's own
# externally-reachable base URL, not the browser-facing N8N_WEBHOOK_URL
# above (which points at n8n's public UI/webhook host).
N8N_INTERNAL_URL=http://localhost:5678

# ============================================================
# REQUIRED STARTING PHASE 9 — Subscription & Billing
# ============================================================
# All optional in this environment (billing routes return 503 rather than
# crashing at boot if unset -- same optional-until-configured pattern as
# GOOGLE_CLIENT_ID/GITHUB_CLIENT_ID above). No Stripe account exists in
# this environment yet; use the Stripe CLI for local development
# (`stripe listen --forward-to localhost:3001/api/v1/webhooks/stripe`
# prints a webhook signing secret to use below).

# Stripe Dashboard -> Developers -> API Keys -> Create restricted key.
# Use sk_test_* for development/staging; sk_live_* for production.
STRIPE_SECRET_KEY=

# Stripe Dashboard -> Developers -> Webhooks -> (your endpoint) -> Signing secret.
# For local dev, use the Stripe CLI's `stripe listen` output instead.
STRIPE_WEBHOOK_SECRET=

# Stripe Dashboard -> Products -> (product) -> Pricing, after creating the
# Starter/Professional/Business products with monthly + annual prices each
# (Free has no Stripe price; Enterprise is quote-only, not self-serve).
STRIPE_PRICE_ID_STARTER_MONTHLY=
STRIPE_PRICE_ID_STARTER_ANNUAL=
STRIPE_PRICE_ID_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_ID_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_ID_BUSINESS_MONTHLY=
STRIPE_PRICE_ID_BUSINESS_ANNUAL=

# Stripe Dashboard -> Developers -> API Keys (safe for the browser).
# Read by apps/web, not apps/api -- see the apps/web public-variables
# section below.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ============================================================
# REQUIRED NOW — apps/web public build-time variables
# (not yet read by any component, but exposed to the browser once they are —
# see apps/web/next.config.ts / README.md §7 for the public-variable rule)
# ============================================================

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
