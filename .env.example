# ViralScopes.io — Environment Variable Reference
# Copy to .env.local and fill in real values. Never commit .env.local or any
# file containing real secrets — only this file (with placeholders) is committed.
# Full reference: README.md §7

# ── Application ──
APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ── Database (Supabase) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DATABASE_POOL_SIZE=10
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# ── Redis ──
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── Authentication ──
JWT_SECRET=your-local-jwt-secret-minimum-32-chars
JWT_REFRESH_SECRET=your-local-refresh-secret-minimum-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── YouTube Data API ──
YOUTUBE_API_KEY=
YOUTUBE_QUOTA_LIMIT=10000
RAPIDAPI_YOUTUBE_KEY=

# ── AI APIs ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Stripe ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email ──
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=hello@viralscopes.io
EMAIL_FROM_NAME=ViralScopes

# ── Object Storage ──
S3_BUCKET=viralscopes-dev
S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Frontend (Public Variables) ──
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── n8n ──
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=http://localhost:5678

# ── Monitoring (docker-compose.dev.yml / docker-compose.prod.yml) ──
GRAFANA_ADMIN_PASSWORD=admin

# ── Production domains (docker-compose.prod.yml — Traefik routing only) ──
APP_DOMAIN=app.viralscopes.io
API_DOMAIN=api.viralscopes.io
N8N_DOMAIN=n8n.viralscopes.io
GRAFANA_DOMAIN=grafana.viralscopes.io
