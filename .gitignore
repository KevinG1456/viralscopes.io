# Dependencies
node_modules/
.pnp
.pnp.js

# Env files (never commit real secrets) — catch-all so a new variant
# (.env.test, .env.staging.local, etc.) can't slip through by omission.
# .env.example is the one deliberate, tracked exception.
.env
.env.*
!.env.example

# Build outputs
dist/
.next/
out/
build/

# Turborepo
.turbo/

# Testing
coverage/

# Logs
*.log
npm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# OS
.DS_Store
Thumbs.db

# Next.js auto-generated (regenerated on every build/dev run)
next-env.d.ts

# Misc
*.tsbuildinfo
.eslintcache
audit.json
