# infra/docker/Dockerfile.api — Fastify backend API
# Build context must be the repository root:
#   docker build -f infra/docker/Dockerfile.api -t viralscopes/api .
#
# Uses `turbo prune` to generate a sub-monorepo containing only apps/api
# and the workspace packages it actually depends on. Without this, plain
# `npm ci` at the root hoists every workspace's dependencies (including
# apps/web's entire Next.js tree) into one shared node_modules, and a
# naive `COPY node_modules` would bloat this image with ~300MB of
# frontend dependencies the API never uses.
#
# Phase 10 Milestone 4 (finding F-09): both FROM lines are pinned to the
# same digest -- `node:22-alpine`'s digest as of 2026-08-01, verified via
# `docker pull node:22-alpine` immediately before pinning -- instead of the
# floating `:22-alpine` tag, so a routine rebuild can't silently pull a
# different (possibly compromised) image under the same tag. The `builder`/
# `pruner` stages derive `FROM base` and inherit the pin automatically; only
# `base` and `runner` reference the upstream image directly. Update this
# digest deliberately (re-pull, re-verify, re-pin) rather than letting it
# drift -- that's the whole point of pinning.

FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS base
RUN npm install -g turbo@^2

# ---- Stage 1: prune the monorepo down to apps/api's actual dependency graph ----
FROM base AS pruner
WORKDIR /app
COPY . .
RUN turbo prune @viralscopes/api --docker

# ---- Stage 2: install pruned deps and build ----
FROM base AS builder
WORKDIR /app

# Pruned package.json files first — cached independently of source changes.
COPY --from=pruner /app/out/json/ .
COPY tsconfig.base.json ./tsconfig.base.json
RUN npm ci

# Pruned full source (only the packages apps/api depends on).
COPY --from=pruner /app/out/full/ .

# BLK-004: apps/api imports @viralscopes/db at runtime (db.plugin.ts), and
# from Phase 9 onward also @viralscopes/shared (packages/shared/src/plans.ts,
# promoted from apps/api/src/lib/plan-limits.ts). Both are npm-workspaces
# symlinks into their package directories -- plain `node` (the runner
# stage's CMD) cannot import TS source directly, so both packages must be
# built to real JS first, and their compiled output must actually be
# present in the runner image alongside the symlink targets. `--filter`
# also builds both automatically via turbo's dependency graph (turbo.json's
# build task has dependsOn: ["^build"]) even without listing them explicitly.
RUN turbo run build --filter=@viralscopes/api

# Strip devDependencies from the already-resolved node_modules tree in
# place, rather than re-running `npm ci` in the runner stage.
RUN npm prune --omit=dev

# ---- Stage 3: production runtime ----
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001

COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=nodejs:nodejs /app/apps/api/package.json ./apps/api/package.json

# Phase 7: the prompt test harness (routes/prompt-library.routes.ts) and
# regression runner read these 10 committed fixture videos at runtime --
# not compiled by tsc (plain JSON, not TS), so they need an explicit COPY
# rather than riding along with apps/api/dist.
COPY --from=builder --chown=nodejs:nodejs /app/apps/api/test-fixtures ./apps/api/test-fixtures

# BLK-004: node_modules/@viralscopes/db is a workspace symlink into
# packages/db -- without the actual directory present here, it dangles and
# the first `import` from it crashes the process (ERR_MODULE_NOT_FOUND).
COPY --from=builder --chown=nodejs:nodejs /app/packages/db/dist ./packages/db/dist
COPY --from=builder --chown=nodejs:nodejs /app/packages/db/package.json ./packages/db/package.json

# Same reasoning, for @viralscopes/shared (Phase 9: packages/shared/src/plans.ts).
COPY --from=builder --chown=nodejs:nodejs /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder --chown=nodejs:nodejs /app/packages/shared/package.json ./packages/shared/package.json

USER nodejs
EXPOSE 3001

# Liveness only — is the process up? Whether it's ready for production
# traffic (DB/Redis/queue wired up) is a separate, stricter check that
# docker-compose.prod.yml applies against /ready at the orchestrator level.
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3001/health || exit 1

CMD ["node", "apps/api/dist/index.js"]
