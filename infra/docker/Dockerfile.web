# infra/docker/Dockerfile.web — Next.js frontend
# Build context must be the repository root:
#   docker build -f infra/docker/Dockerfile.web -t viralscopes/web .

# ---- Stage 1: build ----
FROM node:22-alpine AS builder
WORKDIR /app

# Workspace manifests first so `npm ci` is cached independently of source changes.
COPY package.json package-lock.json turbo.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY apps/web/package.json apps/web/
COPY apps/api/package.json apps/api/

RUN npm ci

COPY packages/ packages/
COPY apps/web/ apps/web/

# Phase 8: apps/web's API client (lib/api/client.ts) reads
# NEXT_PUBLIC_API_URL/NEXT_PUBLIC_APP_URL. Next.js inlines NEXT_PUBLIC_*
# vars into the client bundle at build time, not read at container
# runtime -- env_file in docker-compose.prod.yml has no effect on them,
# which is why they're build ARGs here instead. Defaults match dev; a
# real deploy overrides both via --build-arg (e.g. api.viralscopes.io /
# app.viralscopes.io per Deployment_Guide.md's CORS table).
ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}

# Phase 9 Milestone 4: apps/web now depends on @viralscopes/shared (plan
# definitions for the billing pages) -- `turbo run build` (not `npm run
# build --workspace=apps/web`) so turbo's own dependency graph builds
# @viralscopes/shared's dist/ first, same fix BLK-004 gave Dockerfile.api.
# `npx` (not a bare `turbo`) since this Dockerfile has no global turbo
# install -- unlike Dockerfile.api's `base` stage, `npm ci` here already
# installs the root devDependency into node_modules/.bin, which npx finds.
RUN npx turbo run build --filter=@viralscopes/web

# ---- Stage 2: production runtime ----
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001

# Next.js "standalone" output already contains only the runtime files and a
# pruned node_modules — no separate `npm ci --omit=dev` needed for this image.
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/api/health || exit 1

CMD ["node", "apps/web/server.js"]
