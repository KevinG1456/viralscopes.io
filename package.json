{
  "name": "viralscopes",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@secretlint/secretlint-rule-preset-recommend": "^13",
    "eslint": "^10",
    "eslint-plugin-import": "^2",
    "husky": "^9",
    "lint-staged": "^17",
    "prettier": "^3",
    "secretlint": "^13",
    "turbo": "^2",
    "typescript": "^7",
    "typescript-eslint": "^8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.13.0"
}
