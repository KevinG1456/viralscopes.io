{
  "name": "@viralscopes/db",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "db:migrate": "tsx src/migrate.ts up",
    "db:migrate:down": "tsx src/migrate.ts down",
    "db:migrate:status": "tsx src/migrate.ts status",
    "db:setup-roles": "tsx src/setup-roles.ts",
    "db:seed": "tsx src/seeds/run.ts",
    "db:reset": "tsx src/reset.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26",
    "dotenv": "^17",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.6",
    "typescript": "^7"
  }
}
